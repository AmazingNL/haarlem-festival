# ---------------------------------------------------------------------------
# Setup: copy .env.example .env  —  edit STRIPE_SECRET_KEY for payments.
# ---------------------------------------------------------------------------

APP_URL=http://localhost
APP_DEBUG=true

STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=
STRIPE_DISPLAY_NAME=Haarlem Festival

DB_USER=developer
DB_PASS=secret123
DB_NAME=haarlem_festival

# Mailpit — local email (view at http://localhost:8026). Works with docker compose.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=no-reply@haarlem-festival.local
MAIL_FROM_NAME=Haarlem Festival

TINYMCE_API_KEY=
