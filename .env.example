# ---------------------------------------------------------------------------
# Setup (every teammate)
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# Or run: setup-payment.bat  (creates .env automatically)
#
# Then edit .env — only STRIPE_SECRET_KEY is required for payments.
# Share the Stripe TEST key with teammates privately (not in git).
# ---------------------------------------------------------------------------

APP_URL=http://localhost
APP_DEBUG=true

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
# Optional — only needed for webhook testing (local checkout still works without it)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_DISPLAY_NAME=Haarlem Festival

# Database (defaults match docker-compose.yml — usually no change needed)
DB_USER=developer
DB_PASS=secret123
DB_NAME=haarlem_festival

# Email (Mailpit in Docker — reservation emails appear at http://localhost:8026)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=no-reply@haarlem-festival.local
MAIL_FROM_NAME=Haarlem Festival

# Admin CMS only (TinyMCE) — leave empty unless you use the rich text editor
TINYMCE_API_KEY=
